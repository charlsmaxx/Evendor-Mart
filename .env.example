# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database (Supabase PostgreSQL)
# Copy both strings from Supabase Dashboard → Project Settings → Database → Connection string
# DATABASE_URL = Transaction pooler (port 6543, ?pgbouncer=true) — used by the app at runtime
# DIRECT_URL   = Direct connection (db.[PROJECT].supabase.co:5432) — used by Prisma migrations
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require
# Optional: session pooler for stable local dev (`next dev` uses this when set)
DATABASE_SESSION_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?sslmode=require
DIRECT_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres?sslmode=require

# Supabase Auth
NEXT_PUBLIC_SUPABASE_URL=https://[PROJECT].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Paystack (NGN)
PAYSTACK_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_xxx

# Cloudinary
CLOUDINARY_CLOUD_NAME=your-cloud
CLOUDINARY_API_KEY=your-key
CLOUDINARY_API_SECRET=your-secret

# Upstash Redis (cache + rate limits)
UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-token

# Arcjet (bot protection)
ARCJET_KEY=ajkey_xxx

# Resend (transactional email — P7)
RESEND_API_KEY=re_xxx
RESEND_FROM_EMAIL=Evendor <hello@yourdomain.com>

# Optional
BOOKING_DEPOSIT_PERCENT=30
ENABLE_AI=false
# Secret for Vercel cron routes (Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=generate-a-long-random-string
# Log Prisma queries slower than N ms (0 = off). Default: 500 dev, 300 prod.
PRISMA_LOG_SLOW_MS=500
# Log API routes slower than N ms (via handleApiRoute). Default: 800.
API_LOG_SLOW_MS=800
# Web Vitals: enabled in production by default. Set true to force in dev.
# NEXT_PUBLIC_OBSERVABILITY_ENABLED=true
# Sample rate 0–1 for vitals beacons (default 1).
# NEXT_PUBLIC_OBSERVABILITY_SAMPLE_RATE=1

# Admin access — comma-separated login emails auto-promoted to ADMIN on first /admin visit
ADMIN_EMAILS=you@example.com
# Enable Supabase Realtime for admin audit live feed in local dev (default: off; HTTP polling every 30s)
# NEXT_PUBLIC_ADMIN_AUDIT_REALTIME=true
