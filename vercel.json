{
  "framework": "nextjs",
  "buildCommand": "prisma generate && next build",
  "installCommand": "npm install",
  "regions": ["iad1"],
  "crons": [
    {
      "path": "/api/cron/rewards",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/escrow",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/cron/payouts",
      "schedule": "0 8 * * *"
    }
  ],
  "env": {
    "DATABASE_URL": "@database_url",
    "DIRECT_URL": "@direct_url"
  }
}
